# ---------------------------------------------------------------------------
# Ianes Immobilien — variabili d'ambiente
# Copiare in `.env.local` e compilare con i valori del progetto Supabase.
# ---------------------------------------------------------------------------

# Dominio pubblico: canonical, hreflang, sitemap e OpenGraph.
#
# Vale anche come interruttore dell'indicizzazione: solo l'host di produzione
# (www.ianesimmobilien.it) viene aperto ai motori di ricerca. Su un'anteprima
# va impostato l'URL dell'anteprima stessa — es. https://<progetto>.vercel.app —
# così robots.txt e meta robots si chiudono da soli.
NEXT_PUBLIC_SITE_URL=https://www.ianesimmobilien.it

# Cintura di sicurezza: "1" esclude il deploy dai motori di ricerca anche se
# l'host coincide con quello di produzione. Lasciare vuoto per il sito vero.
# NEXT_PUBLIC_NOINDEX=1

# Supabase → Project Settings → API
# L'anon key è pubblica per progetto: la protezione è data dalle policy RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# NON serve al sito e NON va messa in variabili NEXT_PUBLIC_*:
# la service role key aggira la RLS e si usa solo dalla dashboard o dalla CLI.
# SUPABASE_SERVICE_ROLE_KEY=
